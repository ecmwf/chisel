# port/product.yaml: where the product is, and which product commit the workbench has attested
# (references/two-repo-architecture.md). tools/new-product.sh writes it when it creates the
# product repo.

# The product repository: its own clean repo, not a submodule or a worktree.
repo: <git URL of the product repository>

# The product's working tree, by convention a sibling of the workbench.
checkout: ../<name>-product

# The product mainline.
default_branch: main

# The latest product commit the workbench has attested: each land moves it to that unit's
# product.main_commit.
attested_commit: <product commit, or "none" before the first land>
