# Truth-by-layer, mechanized for `/port-sync-with-base` (merges the base into an instance).
# Two custom drivers do the resolution so a sync never asks the human:
#   git config merge.ours.driver   true          # keep the current (instance) side
#   git config merge.theirs.driver 'cp -f %B %A' # take the other (base) side
# (/port-sync-with-base and tools/new-instance.sh set both.)
#
# PROJECT layer - the INSTANCE is the truth, instance side wins on conflict:
port/**          merge=ours
source/**        merge=ours
target/**        merge=ours
reference/**     merge=ours
docs/evidence/** merge=ours
#
# METHODOLOGY layer - the BASE is the truth, base side wins on conflict.
# (A well-behaved instance never edits these; improvements travel via
# /port-contribute-to-base. A conflict here means a stray local edit, correctly superseded.)
# Single-file rules are ROOT-ANCHORED with a leading slash: an unanchored `README.md`
# pattern matches a file of that name at ANY depth, so it would capture project content
# such as docs/evidence/<pack>/README.md as methodology - and because it sorts after
# `docs/evidence/** merge=ours`, the later rule wins and the evidence README becomes
# clobberable on sync. The leading slash binds the rule to the repo root only.
.opencode/**     merge=theirs
.github/**       merge=theirs
/AGENTS.md       merge=theirs
/README.md       merge=theirs
/.gitattributes  merge=theirs
tools/**         merge=theirs
# Carve-out: an adopter may point their instance at their own base, so this
# pointer is instance-owned and must survive a sync (later rule wins):
tools/base-repo.txt merge=ours
# Carve-out: project-instantiated tool subdirectories are PROJECT layer - a port fills
# them with program-specific tooling, so they must survive a sync. Only generic, reusable
# scripts in tools/ are methodology. (tools/conformance/ is mixed: base-shipped generic
# checks stay methodology; a port's own conformance checks belong in an instance-owned path.)
tools/scoping/** merge=ours
tools/gates/**   merge=ours
tools/diff/**    merge=ours
